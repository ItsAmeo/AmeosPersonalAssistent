{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["pip install dotenv", "pip install discord.py"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["src/main.py"]
    }
  },
  "deploy": {
    "startCommand": "node dist/index.js"
  }
}
